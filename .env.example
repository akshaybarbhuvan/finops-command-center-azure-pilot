# FinOps Command Center — environment template (no secrets required for the local demo)
#
# APP_MODE controls the runtime mode:
#   demo        Local demo: synthetic data, demo persona selector, local ticketing. No external calls.
#   pilot       Pilot deployment: demo persona selector and demo data are disabled; enterprise SSO required.
#   production  Same guarantees as pilot.
# If APP_MODE is unset, `next dev` defaults to demo and any production build defaults to pilot (safe default).
APP_MODE=demo

# Optional label shown in the header as the audience for the walkthrough.
# Keep it generic unless you have approval to name the client.
DEMO_CLIENT_LABEL=Enterprise Client Demo
