{
  "name": "finops-command-center-demo",
  "version": "1.0.0",
  "private": true,
  "description": "FinOps Command Center \u2014 Enterprise FinOps Governance & Optimization Platform (local demo edition)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/run-demo.mjs dev",
    "demo:prod": "node scripts/run-demo.mjs prod",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "validate:data": "vitest run tests/demo-data.test.ts",
    "validate:demo": "node scripts/validate-demo.mjs",
    "build:pilot": "node scripts/pilot/build.mjs",
    "start:pilot": "node scripts/pilot/start.mjs",
    "db:migrate": "tsx --conditions=react-server scripts/pilot/migrate.ts",
    "sync:pilot": "tsx --conditions=react-server scripts/pilot/sync.ts",
    "validate:pilot": "node scripts/pilot/validate-pilot.mjs",
    "preflight:azure": "node scripts/pilot/azure-preflight.mjs",
    "test:pilot": "vitest run tests/pilot",
    "dev:fixtures": "tsx --conditions=react-server scripts/pilot/dev-load-fixtures.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "mssql": "^11.0.2",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "react-is": "$react-is",
    "next": {
      "postcss": "$postcss"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
