# FinOps Command Center — Azure pilot settings (TEMPLATE ONLY — placeholders, no secrets).
# On App Service these are App Settings created by infra/main.bicep. Locally, export them in your shell;
# never commit a filled-in copy (.env.* files are git-ignored).
APP_MODE=pilot
FCC_BUILD_TARGET=pilot
FCC_AUTH_MODE=appservice
FCC_ENTRA_TENANT_ID=<entra-tenant-guid>
FCC_AZURE_SUBSCRIPTION_IDS=<subscription-guid-1>,<subscription-guid-2>
FCC_PUBLIC_ORIGIN=https://<web-app-name>.azurewebsites.net
FCC_DB_DIALECT=mssql
FCC_SQL_SERVER=<sql-server-name>.database.windows.net
FCC_SQL_DATABASE=fcc
# Optional
FCC_ORG_LABEL=Azure pilot
FCC_ADVISOR_CATEGORIES=Cost
FCC_SYNC_INTERVAL_MINUTES=360
FCC_COST_AGGREGATION_COLUMN=Cost
FCC_STALE_AFTER_HOURS_INVENTORY=26
FCC_STALE_AFTER_HOURS_COST=48
FCC_STALE_AFTER_HOURS_ADVISOR=48
FCC_MAX_RESOURCES=50000
# FCC_MANAGED_IDENTITY_CLIENT_ID=<only if a user-assigned identity is used>
